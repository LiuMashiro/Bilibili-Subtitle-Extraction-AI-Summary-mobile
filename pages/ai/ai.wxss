/* pages/ai/ai.wxss */

.ai-page {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 100rpx - env(safe-area-inset-bottom));
}

.ai-header { flex-shrink: 0; }
.ai-header-inner { padding: 20rpx 32rpx 20rpx; }
.ai-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Empty state with rectangular button */
.ai-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 0 32rpx;
}
.ai-gen-btn {
  width: 100%;
  min-height: 96rpx;
  font-size: 34rpx;
  font-weight: 700;
}
.ai-hint {
  font-size: 26rpx;
  color: var(--text-dim);
  animation: fadeIn 0.6s var(--ease-out) 0.3s both;
}

/* Scroll area */
.ai-scroll { flex: 1; }
.ai-content { padding: 24rpx 32rpx 80rpx; }

.streaming-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 60rpx 0;
}

/* AI result card */
.ai-result-card {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
  animation: slideup 0.3s var(--ease-out) both;
}

.retry-corner {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: background 0.2s, color 0.2s;
}
.retry-corner:active { background: var(--primary); }
.retry-corner:active .retry-icon { color: #fff; }
.retry-icon {
  font-size: 32rpx;
  color: var(--text-dim);
  font-weight: 700;
}

.streaming-indicator {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

/* Raw text section */
.raw-section {
  animation: slideup 0.3s var(--ease-out) both;
}
.raw-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
  margin-top: 24rpx;
}
.raw-label:first-child { margin-top: 0; }
.raw-box {
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 24rpx;
  line-height: 1.7;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  max-height: 600rpx;
  overflow-y: auto;
}
.raw-prompt { color: var(--text-dim); border-left: 6rpx solid var(--warning); }
.raw-response { color: var(--text); border-left: 6rpx solid var(--primary); }

/* QA section */
.qa-section { margin-top: 32rpx; }
.qa-divider { height: 1rpx; background: var(--border); margin-bottom: 24rpx; }
.qa-box {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-sm);
}
.qa-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 16rpx;
}
.qa-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.qa-card:last-of-type { border-bottom: none; }
.qa-question {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  background: var(--bg-tertiary);
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
}
.qa-answer { margin-top: 8rpx; }
.qa-answer-raw {
  white-space: pre-wrap;
  font-size: 26rpx;
  color: var(--text-dim);
  line-height: 1.7;
}

.ask-row {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}
.ask-input {
  flex: 1;
  height: 80rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text);
  transition: background 0.2s, box-shadow 0.2s;
}
.ask-input:focus { background: var(--bg-card); box-shadow: 0 0 0 6rpx rgba(0,174,236,0.08); }
.ask-placeholder { color: var(--text-muted); }
.send-btn { flex: none; padding: 0 36rpx; min-height: 80rpx; font-size: 28rpx; }

/* Bottom bar with checkbox */
.bottom-bar {
  display: flex;
  justify-content: flex-end;
  margin-top: 32rpx;
  padding-bottom: 20rpx;
}
.raw-checkbox {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  transition: color 0.2s;
}
.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-xs);
  border: 2rpx solid var(--border);
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s var(--ease-out);
}
.checkbox-box.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.check-mark { color: #fff; font-size: 24rpx; font-weight: 700; }
.checkbox-text { font-size: 26rpx; color: var(--text-dim); font-weight: 500; }
