/* pages/browse/browse.wxss */

.browse-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* Title bar */
.browse-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}
.browse-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: -1rpx;
}

/* Input card — compact inline */
.input-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  animation: panel-in 0.32s var(--ease-spring) both;
}
.bvid-input {
  flex: 1;
  height: 88rpx;
  background: var(--bg-tertiary);
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  box-sizing: border-box;
  transition: background 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}
.bvid-input:focus {
  background: var(--bg-card);
  box-shadow: 0 0 0 6rpx rgba(0, 174, 236, 0.1);
}
.bvid-placeholder { color: var(--text-muted); font-weight: 400; }
.fetch-btn {
  flex: none;
  width: auto !important;
  padding-left: 24rpx !important;
  padding-right: 24rpx !important;
  min-height: 88rpx;
  font-size: 26rpx;
  margin: 0 !important;
  display: inline-flex;
}
.fetch-btn::after { border: none; }

/* 凭证缺失提示条 */
.credential-tip {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 28rpx;
  background: var(--warning-bg);
  color: var(--warning-text);
  border-radius: 16rpx;
  border: 1rpx solid var(--warning-border);
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8rpx;
  animation: slideup 0.3s var(--ease-out) both;
}
.credential-tip:active { opacity: 0.7; }
.credential-tip-text { flex: 1; }
.credential-tip-arrow { font-size: 32rpx; color: var(--warning-text); }

/* Video info */
.video-info-card { animation: slideup 0.4s var(--ease-out) both; }
.video-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.5;
  margin-bottom: 12rpx;
}
.video-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--text-dim);
  font-weight: 500;
}
.meta-divider { color: var(--text-muted); }
.video-desc {
  font-size: 28rpx;
  color: var(--text-dim);
  line-height: 1.6;
  margin-top: 12rpx;
}
.video-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.comment-error-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--danger, #ff3b30);
  line-height: 1.5;
}

/* Source section (collapsible) */
.source-section {
  margin: 0 24rpx 16rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-light);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  animation: slideup 0.3s var(--ease-out) both;
}
.source-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  transition: background 0.2s;
}
.source-header:active { background: var(--bg-tertiary); }
.source-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.source-current {
  flex: 1;
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.source-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s var(--ease-out);
}
.source-arrow.collapsed { transform: rotate(-90deg); }
.arrow-text { font-size: 28rpx; color: var(--text-dim); }

.source-body {
  padding: 0 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  animation: slideup 0.25s var(--ease-out);
}
.sub-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-full);
  background: var(--bg-secondary);
  border: 2rpx solid transparent;
  transition: all 0.25s var(--ease-spring);
}
.sub-chip:active { transform: scale(0.97); }
.sub-chip-active {
  background: var(--primary);
  border-color: var(--primary);
  box-shadow: 0 8rpx 20rpx rgba(0, 174, 236, 0.25);
}
.sub-chip-active .sub-chip-text { color: #fff; }
.sub-chip-active .tag-ai { background: rgba(255,255,255,0.2); color: #fff; }
.sub-chip-active .tag-cc { background: rgba(255,255,255,0.2); color: #fff; }
.sub-chip-text { font-size: 30rpx; font-weight: 500; color: var(--text); }

/* Subtitle browse */
.subtitle-browse {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin: 0 24rpx;
  min-height: 600rpx;
}

/* Action row: copy all + AI analysis */
.sub-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.copy-all-btn {
  flex: 1;
  min-height: 72rpx;
  font-size: 28rpx;
  transition: all 0.2s var(--ease-out);
}
.copy-all-ok {
  color: var(--success, #34c759);
  border-color: var(--success, #34c759);
}
.ai-btn {
  flex: 1;
  min-height: 72rpx;
  font-size: 28rpx;
}

/* Search row (second line) */
.sub-search-row {
  margin-bottom: 16rpx;
}
.search-input {
  width: 100%;
  height: 72rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.search-input:focus { border-color: var(--primary); box-shadow: 0 0 0 6rpx rgba(0,174,236,0.08); }
.search-placeholder { color: var(--text-muted); }

.sub-scroll {
  flex: 1;
  max-height: 1200rpx;
}
.sub-list { padding: 8rpx 0 40rpx; }

.sub-item {
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-light);
  border-left: 6rpx solid transparent;
  transition: all 0.25s var(--ease-out);
  animation: slideup 0.2s var(--ease-out) both;
}
.sub-item:active {
  border-left-color: var(--primary);
  background: var(--primary-light);
}
.sub-time {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 700;
  font-family: "SF Mono", "JetBrains Mono", Consolas, monospace;
  background: rgba(0, 174, 236, 0.06);
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  margin-bottom: 10rpx;
  font-variant-numeric: tabular-nums;
}
.sub-content {
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.7;
}
.seg-highlight {
  background: #FFF352;
  color: #1F2937;
  border-radius: 4rpx;
  padding: 0 2rpx;
  font-weight: 600;
}

.empty-hint { font-size: 24rpx; color: var(--text-muted); }
