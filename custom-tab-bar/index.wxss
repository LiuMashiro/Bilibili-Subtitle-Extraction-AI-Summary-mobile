/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  display: flex;
  background: var(--bg-card, #FFFFFF);
  border-top: 1rpx solid var(--border, #E2E8F0);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tab-bar-item:active { opacity: 0.7; }
.tab-icon {
  width: 48rpx;
  height: 48rpx;
}
.tab-text {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}


@media (prefers-color-scheme: dark) {
  .tab-bar {
    background: #1E293B;
    border-top: 1rpx solid #334155;
  }
}
